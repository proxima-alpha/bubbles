generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model common_code_category {
  code        String   @id @db.VarChar
  name        String   @db.VarChar
  description String?  @db.Text
  order       Int
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  codes common_code[]
}

model common_code {
  category_code        String   @db.VarChar
  code                 String   @db.VarChar
  parent_category_code String?  @db.VarChar
  parent_code          String?  @db.VarChar
  name                 String   @db.VarChar
  description          String?  @db.Text
  value                String?  @db.Text
  order                Int
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz

  @@id([category_code, code])

  category common_code_category @relation(fields: [category_code], references: [code])
  parent   common_code?         @relation("common_code_parent", fields: [parent_category_code, parent_code], references: [category_code, code])
  children common_code[]        @relation("common_code_parent")

  user_models           user[]        @relation("user_model")
  license_key_providers license_key[] @relation("license_key_provider")
  message_roles         message[]     @relation("message_role")
  message_providers     message[]     @relation("message_provider")
  message_models        message[]     @relation("message_model")
  memory_types          memory[]      @relation("memory_type")
  memory_history_types  memory[]      @relation("memory_history_type")
  schedule_types        schedule[]    @relation("schedule_type")
}

model user {
  id             String   @id @default(uuid()) @db.Uuid
  model_category String   @default("model") @db.VarChar
  model          String?  @db.VarChar
  email          String   @unique @db.VarChar
  password       String   @db.VarChar
  salt           String   @db.VarChar
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz

  model_code common_code? @relation("user_model", fields: [model_category, model], references: [category_code, code])

  license_keys license_key[]
  messages     message[]
  memories     memory[]
  schedules    schedule[]
}

model license_key {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  provider_category String   @default("provider") @db.VarChar
  provider          String   @db.VarChar
  key               String   @db.VarChar
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([user_id, provider])

  user          user        @relation(fields: [user_id], references: [id])
  provider_code common_code @relation("license_key_provider", fields: [provider_category, provider], references: [category_code, code])
}

model message {
  id                String                     @id @default(uuid()) @db.Uuid
  user_id           String                     @db.Uuid
  role_category     String                     @default("role") @db.VarChar
  role              String                     @db.VarChar
  provider_category String                     @default("provider") @db.VarChar
  provider          String?                    @db.VarChar
  model_category    String                     @default("model") @db.VarChar
  model             String?                    @db.VarChar
  content           String                     @db.Text
  terms             String[]
  input_tokens      Int?
  output_tokens     Int?
  parent_message_id String?                    @db.Uuid
  root_memory_id    String?                    @db.Uuid
  embedding         Unsupported("vector(768)")?
  is_proceeded      Boolean                    @default(false)
  created_at        DateTime                   @default(now()) @db.Timestamptz

  user           user        @relation(fields: [user_id], references: [id])
  role_code      common_code  @relation("message_role",     fields: [role_category, role],         references: [category_code, code])
  provider_code  common_code? @relation("message_provider", fields: [provider_category, provider],  references: [category_code, code])
  model_code     common_code? @relation("message_model",    fields: [model_category, model],        references: [category_code, code])
  parent_message message?     @relation("message_parent",   fields: [parent_message_id],           references: [id])
  child_messages message[]    @relation("message_parent")
  root_memory    memory?      @relation("message_root_memory", fields: [root_memory_id], references: [id])

  memory_content_messages memory_content__message[]
  message_contents        message_content[]
}

model message_content {
  id         String                      @id @default(uuid()) @db.Uuid
  message_id String                      @db.Uuid
  seq        Int
  content    String                      @db.Text
  embedding  Unsupported("vector(768)")?
  created_at DateTime                    @default(now()) @db.Timestamptz

  message message @relation(fields: [message_id], references: [id])

  @@index([message_id, seq])
}

model memory {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @db.Uuid
  root_memory_id        String?   @db.Uuid
  parent_memory_id      String?   @db.Uuid
  type_category         String    @default("memory_type") @db.VarChar
  type                  String    @db.VarChar
  history_type_category String    @default("memory_history_type") @db.VarChar
  history_type          String?   @db.VarChar
  version               Int       @default(1)
  score                 Float     @default(0)
  sensitivity           Float     @default(0)
  importance            Float     @default(0)
  durability            Float     @default(0)
  reusefulness          Float     @default(0)
  explicit_signal       Float     @default(0)
  repetition_strength   Float     @default(0)
  user_action_score     Float     @default(0)
  llm_confidence_hint   Float     @default(0)
  confirmed_score       Float     @default(0)
  temporary_penalty     Float     @default(0)
  content               String?   @db.Text
  summary               String?   @db.Text
  reference_count       Int       @default(0)
  embedding             Unsupported("vector(768)")?
  is_pinned             Boolean   @default(false)
  is_active             Boolean   @default(true)
  scored_at             DateTime? @db.Timestamptz
  last_referenced_at    DateTime? @db.Timestamptz
  deactivated_at        DateTime? @db.Timestamptz
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz
  deleted_at            DateTime? @db.Timestamptz

  user              user        @relation(fields: [user_id], references: [id])
  type_code         common_code  @relation("memory_type",         fields: [type_category, type],                 references: [category_code, code])
  history_type_code common_code? @relation("memory_history_type", fields: [history_type_category, history_type], references: [category_code, code])

  root_memory    memory?  @relation("memory_root", fields: [root_memory_id], references: [id])
  child_memories memory[] @relation("memory_root")
  parent_memory  memory?  @relation("memory_parent", fields: [parent_memory_id], references: [id])
  newer_memories memory[] @relation("memory_parent")
  contents       memory_content[]
  keywords       memory__keyword[]
  evidence_messages message[] @relation("message_root_memory")
}

model memory_content {
  id         String   @id @default(uuid()) @db.Uuid
  memory_id  String   @db.Uuid
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz

  memory   memory                    @relation(fields: [memory_id], references: [id])
  messages memory_content__message[]
}

model memory_content__message {
  memory_content_id String   @db.Uuid
  message_id        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  @@id([memory_content_id, message_id])

  memory_content memory_content @relation(fields: [memory_content_id], references: [id])
  message        message        @relation(fields: [message_id], references: [id])
}

model keyword {
  code        String   @id @db.VarChar
  name        String   @db.VarChar
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz

  memory__keyword memory__keyword[]
}

model memory__keyword {
  memory_id    String   @db.Uuid
  keyword_code String   @db.VarChar
  created_at   DateTime @default(now()) @db.Timestamptz

  @@id([memory_id, keyword_code])

  memory  memory  @relation(fields: [memory_id], references: [id])
  keyword keyword @relation(fields: [keyword_code], references: [code])
}

model schedule {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  type_category String   @default("schedule_type") @db.VarChar
  type          String   @db.VarChar
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @db.Timestamptz

  @@unique([user_id, type])

  user      user        @relation(fields: [user_id], references: [id])
  type_code common_code @relation("schedule_type", fields: [type_category, type], references: [category_code, code])
}
