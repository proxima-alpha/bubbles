# DB
DATABASE_URL=postgresql://bubbles:bubbles@db:5432/bubbles

# JWT
JWT_SECRET=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Clustering
CLUSTERING_URL=http://clustering:8000
CLUSTERING_MIN_CLUSTER_SIZE=2
CLUSTERING_SIMILARITY_THRESHOLD=0.95
MAX_CLUSTER_SIZE=50

# Scheduler
SCHEDULER_MESSAGE_THRESHOLD=5
SCHEDULER_BATCH_INTERVAL_HOURS=24

# RAG
RAG_TOP_K=5
RECENCY_DECAY_FACTOR=30

# Memory merge 조건
MERGE_MAX_SIMILARITY=0.9
REPETITION_SIMILARITY_THRESHOLD=0.6
REPETITION_GROWTH_RATE=0.1

# Memory 승격 조건
PROMOTION_SCORE_THRESHOLD=0.6
PROMOTION_SENSITIVITY_THRESHOLD=0.6

# Knowledge memory pin 개수 제한
PIN_MAX_COUNT=20

# 망각 옵션 (score 기반 자동 정리)
FORGETTING_ENABLED=false
FORGETTING_SCORE_THRESHOLD=0.2
FORGETTING_STALE_DAYS=60
